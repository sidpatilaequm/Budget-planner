# Copy to .env and change every value before going live.
MYSQL_USER=budget
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password
# Long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_HOURS=8
APP_PORT=8080
CORS_ORIGINS=http://localhost:8080
